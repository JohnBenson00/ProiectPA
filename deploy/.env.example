# ---- Râșnov Trains settings (copy to .env and edit) ----

# The address passengers use. A subdomain keeps your existing hymemory.xyz site untouched.
DOMAIN=trains.hymemory.xyz
PUBLIC_URL=https://trains.hymemory.xyz

# First administrator password. Leave empty to get a random one in data/initial-admin-password.txt
ADMIN_PASSWORD=

# Confirmation emails (optional). Without SMTP the site works; customers open tickets with code + email.
# SMTP_URL=smtps://bilete%40hymemory.xyz:PASSWORD@mail.hymemory.xyz:465
# MAIL_FROM=Râșnov Trains <bilete@hymemory.xyz>

# Only for option B (Cloudflare Tunnel): the token from the Cloudflare dashboard
# CLOUDFLARE_TUNNEL_TOKEN=

# One proxy (Caddy, Cloudflare Tunnel or nginx) sits in front of the app
TRUST_PROXY=1

# false = real operation (no demo logins, no fake bookings); true = demo installation
DEMO=false

# Departures are generated this many days ahead, backups kept this many days
SCHEDULE_DAYS=60
BACKUP_KEEP=14
